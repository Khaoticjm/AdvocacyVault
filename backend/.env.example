# ── PHI Encryption ────────────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHI_ENCRYPTION_KEY=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── IP Hashing (HIPAA — raw IP never stored) ──────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
IP_HASH_SALT=

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (matches docker-compose default):
#   postgresql+asyncpg://postgres:postgres@db/advocacyvault
# Production: use a secrets manager, never commit real credentials
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db/advocacyvault

# Set to false in production — SQL logs may expose PHI
DB_ECHO_SQL=false

# ── LLM — Primary (adjuster workbench) ───────────────────────────────────────
PRIMARY_LLM_MODEL=gpt-4o

# ── LLM — Verifier (MUST differ from PRIMARY_LLM_MODEL) ─────────────────────
# Boot validator raises ValidationError if VERIFIER_LLM_MODEL == PRIMARY_LLM_MODEL
VERIFIER_LLM_PROVIDER=anthropic
VERIFIER_LLM_MODEL=claude-sonnet-4-6
VERIFIER_LLM_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of allowed origins
# Local dev: ["http://localhost:3000"]
# Production: ["https://your-domain.com"]
ALLOWED_ORIGINS=["http://localhost:3000"]
